extends Node3D
class_name CollisionCutout

## Объём, внутри которого ModelCollisions не строит коллизию по мешу.
## Нужен там, где геометрия модели физически непроходима для игрока
## (например, второй лестничный марш нависает над первым), а проход
## обеспечивают явные коллайдеры сцены. На рендер не влияет.

@export var size: Vector3 = Vector3(2.0, 2.0, 2.0)
